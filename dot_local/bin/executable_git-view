#! /bin/bash

branch_raw=$(git branch --show-current)
branch=$(printf '%s' "$branch_raw" | urlencode)
remote=$(git remote get-url origin)

if [[ $remote =~ git@github\.com:(.*)\.git ]]; then
	host=github; repo_url="https://github.com/${BASH_REMATCH[1]}"
elif [[ $remote =~ (https://github.com/.*) ]]; then
	host=github; repo_url=${BASH_REMATCH[1]}
elif [[ $remote =~ git@ssh.dev.azure.com:v3/([^/]+)/([^/]+)/([^/]+)$ ]]; then
	host=azdo; repo_url="https://dev.azure.com/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/_git/${BASH_REMATCH[3]}"
elif [[ $remote =~ https://.*@(dev.azure.com/.*) ]]; then
	host=azdo; repo_url="https://${BASH_REMATCH[1]}"
fi

case $host in
github)
	url=$repo_url
	[[ $branch_raw != main ]] && url+="/tree/$branch"
	;;
azdo)
	url="$repo_url?"
	[[ $branch_raw != main ]] && url+="version=GB$branch&"
	url+="_a=contents"
	;;
esac

if [[ -n $url ]]; then
	open "$url"
else
	echo "Unable to decipher git repo $remote"
fi
